# CampusOverflow 环境变量样例（Issue #37）
#
# 用法（在仓库根目录执行，二选一）：
#   cp .env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d --build
# 或
#   cp .env.example .env
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
#
# 注意：只写 `cp .env.example .env` 却不加 --env-file 是无效的 —— 用 -f 指定 compose
# 文件时，Compose 默认去 deploy/ 目录找 .env。下面的变量名必须与 deploy/docker-compose.yml
# 里的 ${...} 完全一致，否则 compose 会静默回退到默认值（密码配置形同虚设）。
# 一致性由 node scripts/verify-observability.mjs 自动校验。

# ===== MySQL（compose 读取）=====
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app

# ===== 后端（compose 读取）=====
# prod,demo 会灌演示数据；正式环境去掉 demo
SPRING_PROFILES=prod,demo
# AES-256-GCM 的 Base64 32 字节密钥，生产必须替换
CO_FIELD_KEY=change-me-base64-32-byte-key

# ===== 镜像 tag（compose 读取，用于部署与回滚）=====
# 本地构建时留空走 :local；部署时填 ghcr.io/<owner>/<repo>-backend:<sha 或版本>
BACKEND_IMAGE=
WEB_IMAGE=

# ===== 监控（compose 读取，需 --profile observability）=====
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana

# ===== 以下为参考信息，compose 中固定值，不是可配置项 =====
# MYSQL_DATABASE=campus_overflow / MYSQL_USER=campus / MYSQL_PORT=3306
# REDIS_PORT=6379 / SERVER_PORT=8080
# 前端同源调用 /api，由 deploy/nginx.conf 反代，无需 VITE_API_BASE_URL
