<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campusoverflow</groupId>
        <artifactId>co-qa</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>co-qa-application</artifactId>
    <packaging>jar</packaging>
    <name>Q&amp;A 问答核心 :: application（用例编排）</name>
    <!-- 本模块覆盖率门禁：实测值见 docs/05-质量/测试策略.md，取比实测低 3~5 个点作为下限，
         目的是防止后续改动把覆盖拉回去，而不是为了数字好看。全局默认 0.75，见根 POM。 -->
    <properties>
        <domain.coverage.minimum>0.95</domain.coverage.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-qa-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-qa-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-identity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
