<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campusoverflow</groupId>
        <artifactId>co-qa</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>co-qa-domain</artifactId>
    <packaging>jar</packaging>
    <name>Q&amp;A 问答核心 :: domain（纯 Java）</name>
    <properties>
        <!-- 适应度函数 FF-4：Q&A 领域层行覆盖率门禁（issue #19）。
             实测 230/230 行 = 100%（Question / Answer / MarkdownBody / Tags / Comment 全部覆盖），故把下限提到 0.95：留 11 行缓冲，但覆盖被拉回去就会红。
             覆盖全模块的通用阈值 domain.coverage.minimum 仍保持 0，不影响其他上下文。 -->
        <qa.domain.coverage.minimum>0.95</qa.domain.coverage.minimum>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-domain-coverage</id>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${qa.domain.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
