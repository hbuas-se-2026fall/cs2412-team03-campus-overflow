<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.campusoverflow</groupId>
        <artifactId>co-qa</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>co-qa-domain</artifactId>
    <packaging>jar</packaging>
    <name>Q&amp;A 问答核心 :: domain（纯 Java）</name>
    <properties>
        <!-- 本模块覆盖率门禁（issue #19）：Q&A 领域层行覆盖率下限 0.95。
             实测 230/230 行 = 100%（Question / Answer / MarkdownBody / Tags / Comment 全部覆盖），
             0.95 留 11 行缓冲，但覆盖被拉回去就会红。

             注：早期这里用的是独立属性 qa.domain.coverage.minimum + 独立 execution
             check-domain-coverage，与父 POM 的 check-all-modules（读 domain.coverage.minimum，
             未覆写时继承全局 0.75）并存，导致「表格写的、注释写的、实际生效的」三个口径打架。
             现已统一为覆写 domain.coverage.minimum，并删除那条独立规则——与其他 9 个模块一致。 -->
        <domain.coverage.minimum>0.95</domain.coverage.minimum>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.campusoverflow</groupId>
            <artifactId>co-shared-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
