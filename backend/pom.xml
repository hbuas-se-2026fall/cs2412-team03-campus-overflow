<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：统一依赖版本（Spring Boot BOM）与插件配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.campusoverflow</groupId>
    <artifactId>campus-overflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CampusOverflow :: Parent</name>
    <description>大学校园版 Stack Overflow —— 模块化单体（DDD 限界上下文 + 六边形分层）</description>

    <modules>
        <module>co-shared-kernel</module>
        <module>co-identity</module>
        <module>co-qa</module>
        <module>co-reputation</module>
        <module>co-discovery</module>
        <module>co-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.6</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
        <commonmark.version>0.24.0</commonmark.version>
        <owasp-sanitizer.version>20240325.1</owasp-sanitizer.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- 全后端行覆盖率门禁（适应度函数 FF-4 / Issue #97）。
             阈值只在根 POM 定义一次，由下面 jacoco:check 的 check-all-modules 下发到每个后端模块，
             CI 不再用 -D 临时覆盖，也不再只对 Q&A 一个模块生效。

             2026-11-16 收紧：全局下限 0.70 -> 0.75（当前最低的模块 co-bootstrap 为 79.4%），
             并给 10 个真正跑单测的模块各自加了下限 0.90~0.95（见各模块 POM 的 properties）。
             依据是实测值而非目标值：门禁用来防止覆盖被改回去，不是为了数字好看。 -->
        <domain.coverage.minimum>0.75</domain.coverage.minimum>
        <!-- 默认所有模块都受门禁约束。确实测不到的模块必须在自己的 POM 里覆写为 true
             并写清原因与解除条件，不许用命令行参数或调低阈值绕过。 -->
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-identity-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-qa-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-reputation-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-discovery-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.campusoverflow</groupId>
                <artifactId>co-shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.commonmark</groupId>
                <artifactId>commonmark-ext-gfm-tables</artifactId>
                <version>${commonmark.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
                <artifactId>owasp-java-html-sanitizer</artifactId>
                <version>${owasp-sanitizer.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- Issue #97：门禁搬回根 POM。父 POM 的 <plugins> 会被全部 27 个模块继承，
                         因此每个真正跑了单测、生成了 jacoco.exec 的模块都要过 0.70 这条线。
                         没有 jacoco.exec 的模块 JaCoCo 会静默跳过，CI 阶段 2b 用 exec 存在性
                         断言守住这个风险；无法达标的模块用 jacoco.check.skip 显式登记。 -->
                    <execution>
                        <id>check-all-modules</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${domain.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
