{
  "uid": "campus-overflow-runtime",
  "title": "CampusOverflow 运行态 (Lab8)",
  "description": "Issue #39：QPS / P95 / 5xx / JVM 堆 / DB 连接池 / 发件箱 / 声誉对账 / 实例存活。指标均来自 Spring Boot Actuator + 仓库内已注册的自定义指标。",
  "tags": ["campus-overflow", "lab8", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "enable": false,
        "iconColor": "blue",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "changes(process_uptime_seconds{application=\"campus-overflow\"}[5m]) > 0"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. QPS（每秒请求数）",
      "description": "全部 HTTP 请求吞吐，来自 http_server_requests_seconds_count。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"campus-overflow\"}[5m]))",
          "legendFormat": "QPS"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. P95 响应延迟",
      "description": "SLO 阈值 500ms，对应 rules.yml 的 HighP95Latency。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"campus-overflow\"}[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "3. 5xx 错误率",
      "description": "SLO 阈值 1%，对应 rules.yml 的 HighHttpErrorRate。clamp_min 避免零流量时除零。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"campus-overflow\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"campus-overflow\"}[5m])), 0.001)",
          "legendFormat": "5xx 占比"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4. JVM 堆内存使用",
      "description": "对应 rules.yml 的 JvmHeapNearLimit（85% 水位）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"campus-overflow\",area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{application=\"campus-overflow\",area=\"heap\"})",
          "legendFormat": "heap max"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5. DB 连接池（Hikari 活跃连接）",
      "description": "活跃连接长期贴近上限说明慢 SQL 或连接泄漏。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"campus-overflow\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_pending{application=\"campus-overflow\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "6. 事务性发件箱：积压 / 死信",
      "description": "ADR-002。死信 >0 必须人工介入，对应 OutboxDeadLetters 告警。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "co_outbox_backlog{application=\"campus-overflow\"}",
          "legendFormat": "backlog"
        },
        {
          "refId": "B",
          "expr": "co_outbox_dead_letters{application=\"campus-overflow\"}",
          "legendFormat": "dead letters"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "7. 声誉对账不一致账户数（应恒为 0）",
      "description": "FF-8 / ADR-004。非零即为数据一致性事故，对应 ReputationMismatch 告警。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "co_reputation_mismatches{application=\"campus-overflow\"}",
          "legendFormat": "mismatches"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "8. 后端实例存活",
      "description": "Prometheus 抓取状态，0 表示实例不可达，对应 ServiceDown 告警。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"campus-overflow\"}",
          "legendFormat": "up"
        }
      ]
    }
  ]
}
